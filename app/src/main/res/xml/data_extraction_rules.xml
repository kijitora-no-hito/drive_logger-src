<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+。クラウドバックアップ・端末間の移行に位置の記録（DB）と動画を含めない。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <!-- オンラインランキングの参加の情報（ID・合言葉。機種変更は設定のバックアップか端末間の移行で引き継ぐ） -->
        <exclude domain="sharedpref" path="ranking.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>